    re.compile(r"(اشرح|فسّر|معنى) نتيجتي", re.I),
    re.compile(r"هل نتيجتي (طبيعية|مرتفعة|منخفضة)", re.I),
    re.compile(r"تفاعل الأدوية|تداخل الأدوية", re.I),
    re.compile(r"لخّص|ملخص|تحليل",            re.I),
